# Which tutor model to use: anthropic | ollama | mock (mock = demo mode, no real corrections)
AD_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
# Optional: AD_CLAUDE_MODEL=claude-opus-5-5   (or claude-sonnet-5-5 / claude-haiku-4-5, see docs/LLM_OPTIONS.md)
# Optional: AD_CLAUDE_EFFORT=low
# Self-hosted alternative:
# AD_LLM_PROVIDER=ollama
# AD_OLLAMA_URL=http://localhost:11434
# AD_OLLAMA_MODEL=qwen3:14b

# Friends need this code to register. The first account created becomes the admin.
AD_INVITE_CODE=change-me
# Max tutor replies per person per day (cost cap)
AD_DAILY_AI_LIMIT=200
# Set to 1 when the site is served over HTTPS
AD_SECURE_COOKIES=1
# Where the SQLite database lives (put it on a persistent disk)
AD_DB_PATH=/data/auf_deutsch.db
